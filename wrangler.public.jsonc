{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkx-public",
  "account_id": "d2bbd39f28d4cd850b00a604d5acde0f",
  "main": "public-worker/index.mjs",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/admin*"
    ]
  },
  "vars": {
    "PUBLIC_API_URL": "https://cloud1-7gmtcu4s3aebce27-1383643768.ap-shanghai.app.tcloudbase.com/admin-api/public-api"
  },
  "ratelimits": [
    {
      "name": "PUBLIC_API_RATE_LIMIT",
      "namespace_id": "26091401",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "UPSTREAM_RATE_LIMIT",
      "namespace_id": "26091402",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "catx.eu.org/*",
      "zone_id": "039dcc04a1916e86679dae0b56d8088a"
    },
    {
      "pattern": "www.catx.eu.org/*",
      "zone_id": "039dcc04a1916e86679dae0b56d8088a"
    }
  ]
}
