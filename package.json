{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:cloudbase": "vite --config vite.cloudbase.config.ts",
    "build:cloudbase": "vite build --config vite.cloudbase.config.ts && vite build --config vite.cloudbase.config.ts --ssr static/render.tsx --outDir .static-ssr && node scripts/prerender.mjs && npm --prefix admin run build && node scripts/bundle-admin.mjs",
    "test:cloudbase": "npm --prefix admin test && node --test tests/cloudbase.test.mjs tests/pricing.test.mjs",
    "dev:public": "vite --config vite.public.config.ts",
    "build:public": "vite build --config vite.public.config.ts",
    "check:public": "tsc -p tsconfig.public.json",
    "test:public": "node --test tests/public-worker.test.mjs public-site/tests/*.test.mjs",
    "preview:public": "wrangler dev --config wrangler.public.jsonc",
    "deploy:public": "npm run build:public && wrangler deploy --config wrangler.public.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
